# ===== 前端环境变量示例 =====
# 使用方式：复制为 .env 后按需填写（.env 已被 gitignore，不会提交真实 Key）

# 高德 JS API Key（可选）：用于后台地理编码/POI 抓取等，
# 地图展示已改为 Leaflet + 栅格瓦片，不依赖该 Key
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=

# ===== 地图瓦片（Leaflet） =====
# 默认使用高德栅格瓦片（无需 Key）；可替换为天地图 / OSM
# 天地图示例：
# VITE_MAP_TILE_URL=https://t{s}.tianditu.gov.cn/vec_w/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&LAYER=vec&STYLE=default&TILEMATRIXSET=w&FORMAT=tiles&TILEMATRIX={z}&TILEROW={y}&TILECOL={x}&tk=你的天地图Key
# VITE_MAP_TILE_SUBDOMAINS=0,1,2,3,4,5,6,7
# VITE_MAP_TILE_ATTR=© 天地图
#
# OSM 示例：
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILE_SUBDOMAINS=
# VITE_MAP_TILE_ATTR=© OpenStreetMap contributors
