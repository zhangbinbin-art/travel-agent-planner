# ===== 后端环境变量样例 =====
# 使用方法：复制本文件为 .env 后按需修改
#   Windows: copy .env.example .env
# 注意：.env 已加入 .gitignore，真实密钥不要提交到仓库

DATABASE_URL=mysql+pymysql://root:password@localhost:3306/travel_bishe?charset=utf8mb4
SECRET_KEY=travel-bishe-secret-key-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_ORIGIN=http://localhost:5173

# 高德 Web 服务 Key：用于 /api/v1/map/geo-code 地理编码、驾车距离计算
# 必须申请「Web服务」类型的 Key，不能与前端 VITE_AMAP_KEY（Web端 JS API）共用
AMAP_WEB_KEY=

# 兼容旧配置：未填 AMAP_WEB_KEY 时回退使用 AMAP_KEY
# AMAP_KEY=
